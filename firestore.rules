rules_version = '2';

// Firestore Security Rules untuk MotionVault
// Cara pakai: Firebase Console → Firestore Database → Rules → tempel isi file ini → Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // Semua orang boleh BACA daftar preset (biar situs bisa dibuka publik).
    // Cuma email admin di bawah ini yang boleh tambah/hapus preset, atau
    // ubah field APAPUN selain "downloads". (Dikunci ke email spesifik,
    // bukan cuma "asal sudah login", sebagai lapisan keamanan ekstra kalau
    // suatu saat ada akun lain di project ini.)
    //
    // Pengecualian sempit: siapa aja boleh nambah hitungan "downloads"
    // tepat +1 tiap kali ada yang klik unduh — biar hitungannya beneran
    // kesimpen, bukan cuma keliatan nambah di layar orang yang klik doang.
    // Field lain nggak bisa diubah lewat celah ini.
    match /presets/{presetId} {
      allow read: if true;
      allow create, delete: if request.auth != null
                    && request.auth.token.email == 'nezzstore081@gmail.com';
      allow update: if (request.auth != null && request.auth.token.email == 'nezzstore081@gmail.com')
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
                        && request.resource.data.downloads == resource.data.downloads + 1);

      // Rating bintang + komentar singkat per preset. Siapa aja boleh
      // nambah rating baru (create), tapi cuma admin yang boleh ubah/hapus
      // punya orang lain (moderasi). Dibatasi 1-5 bintang dan komentar
      // maksimal 300 karakter biar nggak disalahgunakan buat spam panjang.
      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if request.resource.data.stars is int
                      && request.resource.data.stars >= 1
                      && request.resource.data.stars <= 5
                      && (!('comment' in request.resource.data)
                          || (request.resource.data.comment is string
                              && request.resource.data.comment.size() <= 300));
        allow update, delete: if request.auth != null
                      && request.auth.token.email == 'nezzstore081@gmail.com';
      }
    }

    // Laporan "link rusak" dari pengunjung. Siapa aja boleh KIRIM laporan
    // (create), tapi cuma admin yang boleh BACA/hapus daftarnya — biar
    // orang nggak bisa lihat/oprek laporan orang lain lewat console browser.
    match /reports/{reportId} {
      allow create: if request.resource.data.presetId is string
                    && request.resource.data.presetId.size() > 0;
      allow read, update, delete: if request.auth != null
                    && request.auth.token.email == 'nezzstore081@gmail.com';
    }

    // Pengaturan situs (banner pengumuman + maintenance mode). Semua orang
    // boleh BACA (biar banner/layar maintenance-nya kelihatan buat semua
    // pengunjung), cuma admin yang boleh UBAH.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'nezzstore081@gmail.com';
    }

    // Profil pengunjung (dari Login Google). Semua orang boleh BACA profil
    // siapa aja (dibutuhkan buat halaman Creator/Leaderboard). Pengunjung
    // cuma boleh bikin/ubah profil MILIK SENDIRI. Field identitas (nama
    // tampilan, bio, foto) bebas diubah; xp/achievements/downloadCount/
    // checkInStreak boleh berubah lewat celah sempit & terbatas di bawah
    // (lihat detailnya di comment allow update). "level" SELALU dihitung
    // di client dari xp (computeLevel() di index.html), bukan field yang
    // ditulis sendiri. followerCount/followingCount tetap 100% admin-only.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      // "Update" biasa (nama/bio/foto) TETAP dibatasi ke field identitas.
      // Selain itu, ada 1 celah sempit yang meniru pola "downloads" di atas:
      // pengunjung boleh nambah XP MILIK SENDIRI, tapi paling banyak +10
      // per write (nggak bisa loncat ke angka manapun), dan boleh nambah
      // SATU achievement ke array-nya, asal ID-nya ada di daftar yang
      // dikenal di bawah (nggak bisa nulis achievement sembarangan).
      // "level" dihitung di client dari xp (lihat computeLevel() di
      // index.html) — field level/followerCount/followingCount tetap
      // 100% admin-only, nggak ada celah buat itu.
      //
      // Ini bukan anti-cheat sempurna (skrip yang gigih tetap bisa
      // nge-spam +10 berkali-kali) — sama persis trade-off-nya kayak
      // counter "downloads" di atas. Anti-cheat yang bener butuh Cloud
      // Functions (infra terpisah, belum dipakai di proyek ini).
      allow update: if request.auth != null && (
        request.auth.token.email == 'nezzstore081@gmail.com'
        || (
          request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName','bio','photoURL','xp','achievements','lastCheckInDate','checkInStreak','downloadCount'])
          && request.resource.data.xp >= resource.data.xp
          && request.resource.data.xp <= resource.data.xp + 10
          && request.resource.data.downloadCount >= resource.data.downloadCount
          && request.resource.data.downloadCount <= resource.data.downloadCount + 1
          && (
            request.resource.data.achievements == resource.data.achievements
            || (
              request.resource.data.achievements.size() == resource.data.achievements.size() + 1
              && request.resource.data.achievements[resource.data.achievements.size()]
                   in ['first_follow','first_download','downloader_5','downloader_20','streak_3','streak_7','early_bird']
            )
          )
        )
      );
    }

    // Relasi Follow (pengunjung login -> nama creator). Creator di sini
    // cuma label teks di preset, bukan akun sendiri, jadi yang diikuti
    // adalah NAMANYA, bukan uid. Semua orang boleh BACA (buat hitung
    // jumlah follower publik), tapi orang cuma boleh bikin/hapus relasi
    // follow ATAS NAMA DIRINYA SENDIRI (followerId harus cocok uid yang
    // sedang login) — nggak bisa follow/unfollow atas nama orang lain.
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.creatorName is string
                    && request.resource.data.creatorName.size() > 0;
      allow delete: if request.auth != null && resource.data.followerId == request.auth.uid;
    }

    // Pesan privat. Scope-nya SENGAJA dibatasi ke Pengunjung <-> Admin dulu
    // (bukan bebas antar-pengguna) — creator di MotionVault belum tentu
    // punya akun beneran (lihat catatan di /follows), jadi "kirim pesan ke
    // creator manapun" belum bisa dijamin selalu ada penerimanya.
    //
    // 1 percakapan = 1 dokumen di /conversations, field "participants"
    // berisi PERSIS 2 uid. Cuma 2 orang itu yang boleh baca/tulis apapun
    // di percakapan itu (dicek pakai get() ke dokumen induknya dari dalam
    // subcollection messages). Pesan yang udah terkirim nggak bisa diubah
    // atau dihapus (nggak ada rule update/delete buat messages = otomatis
    // ditolak keduanya).
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      // update cuma buat metadata preview (lastMessage/lastMessageAt) —
      // daftar partisipannya sendiri nggak boleh berubah setelah dibuat.
      allow update: if request.auth != null && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000;
      }
    }
  }
}
